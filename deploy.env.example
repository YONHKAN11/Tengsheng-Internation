# 填写后保存，然后运行 bash deploy.sh
# DOMAIN 可以先填服务器公网 IP（如 43.108.40.121）做 HTTP 测试，
# 买好域名并解析后改成域名，重新运行 deploy.sh 即自动启用 HTTPS。

DOMAIN=43.108.40.121
ACME_EMAIL=you@example.com

ADMIN_EMAIL=admin@tengsheng.local
ADMIN_PASSWORD=change-this

# 留 change-this，deploy.sh 会自动生成随机值
DB_PASSWORD=change-this
PAYLOAD_SECRET=change-this

# 首次部署保持 true，日志出现 Seeded 后改为 false 并重启 cms
PAYLOAD_PUSH=true
