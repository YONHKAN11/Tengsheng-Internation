# ---------------------------------------------------------------
# Local development (default): SQLite database + local media files
# ---------------------------------------------------------------
DATABASE_URL=file:./tengsheng.db
PAYLOAD_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@tengsheng.local
ADMIN_PASSWORD=Tengsheng-Admin-2026

# ---------------------------------------------------------------
# Cloud deployment (Railway + Neon + Cloudflare R2)
# Uncomment and fill these on the server. Local defaults stay active
# when they are absent.
# ---------------------------------------------------------------
# Postgres (Neon / Railway). Any postgres:// URL switches the adapter.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# First deploy only: create the tables automatically, then remove it.
# PAYLOAD_PUSH=true

# Cloudflare R2 (S3-compatible). When S3_BUCKET is set, uploads go to R2.
# S3_BUCKET=tengsheng-media
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# Public URL of the bucket (custom domain or r2.dev)
# S3_PUBLIC_URL=https://media.your-domain.com

# Cloudflare Pages deploy hook. When set, admin saves trigger a rebuild
# instead of writing to a local site/ folder.
# DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/...

# ---------------------------------------------------------------
# Minimal Railway mode (no R2 needed): mount ONE volume at /data
# and point both upload folders there. Leave S3_* empty.
# ---------------------------------------------------------------
# MEDIA_DIR=/data/media
# VIDEOS_DIR=/data/videos
